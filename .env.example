# AI Model Configuration (Groq Cloud)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Qwen 3B / Local / Custom Model Configuration
USE_LOCAL_LLM=true
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_KEY=your_api_key_here
LOCAL_MODEL=qwen2.5:3b

# Official Alibaba Cloud Qwen (Optional if using DashScope)
# QWEN_API_KEY=sk-your_alibaba_qwen_key
# QWEN_MODEL=qwen-plus
SECRET_KEY=your_random_secret_jwt_key_here

# Cloud Database (MySQL)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=maths_tutor_db
